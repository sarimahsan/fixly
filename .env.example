# Fixly Environment Configuration Template

# Application Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Connection
MONGODB_URI=mongodb://localhost:27017/fixly

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# SSH Monitored Target Server Configuration
SSH_HOST=localhost
SSH_PORT=22
SSH_USER=root
SSH_KEY_PATH=~/.ssh/id_rsa

# AI Logic & LLM Configuration
AI_PROVIDER=GROQ
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=llama-3.3-70b-versatile
