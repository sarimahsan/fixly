# Fixly Environment Configuration Template

# Application Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MySQL Database Connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fixly

# Authentication & Encryption
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
SETTINGS_ENCRYPTION_KEY=your_32_byte_or_longer_settings_secret_here

# SSH Monitored Target Server Configuration
SSH_HOST=localhost
SSH_PORT=22
SSH_USER=root
SSH_KEY_PATH=~/.ssh/id_rsa
MONITOR_LOG_PATH=/var/log/syslog
VITALS_INTERVAL_MS=5000
PHASE5_REAL_SSH=0
PHASE5_SERVER_ID=phase5-remote

# AI Logic & LLM Configuration
AI_PROVIDER=GROQ
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=llama-3.3-70b-versatile

# GitHub Automation
GITHUB_OWNER=your_github_org_or_user
GITHUB_REPO=your_repository_name
GITHUB_TOKEN=your_github_token_here
GITHUB_BASE_BRANCH=main
