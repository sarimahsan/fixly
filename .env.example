# Fixly Environment Configuration Template

# Application Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Connection
MONGODB_URI=mongodb://localhost:27017/fixly

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Settings Encryption (used for encrypted GitHub token storage)
SETTINGS_ENCRYPTION_KEY=your_32_byte_or_longer_settings_secret_here

# SSH Monitored Target Server Configuration
SSH_HOST=localhost
SSH_PORT=22
SSH_USER=root
SSH_KEY_PATH=~/.ssh/id_rsa
MONITOR_LOG_PATH=/var/log/syslog
VITALS_INTERVAL_MS=5000
# Optional Phase 5 live SSH prerequisite check; defaults to deterministic local doubles when unset.
PHASE5_REAL_SSH=0
PHASE5_SERVER_ID=phase5-remote

# AI Logic & LLM Configuration
AI_PROVIDER=GROQ
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=llama-3.3-70b-versatile

# GitHub Automation (optional for Phase 3 PR creation)
GITHUB_OWNER=your_github_org_or_user
GITHUB_REPO=your_repository_name
GITHUB_TOKEN=your_github_token_here
GITHUB_BASE_BRANCH=main
