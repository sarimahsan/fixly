{
  "name": "fixly",
  "version": "1.0.0",
  "description": "AI-powered incident detection and self-healing system",
  "main": "src/server/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server/server.js",
    "test:types": "node tests/types.test.js",
    "test:models": "node tests/models.test.js",
    "test:auth": "node tests/auth.test.js",
    "test:rbac": "node tests/rbac.test.js",
    "test:settings": "node tests/settings.test.js",
    "test:monitoring": "node tests/monitoring.test.js",
    "test:ai:diag": "node tests/ai_git.test.js",
    "test:ai:fix": "node tests/ai_git.test.js",
    "test:diff": "node tests/ai_git.test.js",
    "test:git": "node tests/ai_git.test.js",
    "test:recovery": "node tests/ai_git.test.js",
    "test:ai-git": "node tests/ai_git.test.js",
    "db:check": "node scripts/check_db.js",
    "test": "npm run test:types && npm run test:models && npm run test:auth && npm run test:rbac && npm run test:settings && npm run test:monitoring && npm run test:ai-git",
    "client:install": "npm install --prefix src/client",
    "client:dev": "npm run dev --prefix src/client",
    "client:build": "npm run build --prefix src/client"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mongoose": "^8.2.0",
    "node-ssh": "^13.2.1",
    "simple-git": "^3.27.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {}
}
